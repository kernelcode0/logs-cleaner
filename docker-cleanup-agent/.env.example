# Server identity
AGENT_SERVER_ID=production-eu-01

# Behavior
AGENT_DRY_RUN=false
AGENT_LOG_LEVEL=info
AGENT_LOG_FORMAT=json

# Cleanup
AGENT_CLEANUP_THRESHOLD_MB=100
AGENT_CLEANUP_TOP_CONSUMERS=5
AGENT_CLEANUP_MODE=truncate
# Comma-separated container names to never truncate:
# AGENT_CLEANUP_EXCLUDED_CONTAINERS=db-prod,auth-server

# Schedule (cron expression, default = every 12h)
AGENT_SCHEDULE_CRON="0 */12 * * *"

# Email — fill in real values; never commit this file with credentials
AGENT_EMAIL_ENABLED=true
AGENT_EMAIL_SMTP_HOST=smtp.gmail.com
AGENT_EMAIL_SMTP_PORT=587
AGENT_EMAIL_SMTP_USER=your-user@gmail.com
AGENT_EMAIL_SMTP_PASSWORD=your-app-password
AGENT_EMAIL_SMTP_FROM=docker-cleanup@yourdomain.com
AGENT_EMAIL_TO=ops@yourdomain.com,dev@yourdomain.com
AGENT_EMAIL_SUBJECT_PREFIX="[Docker Log Cleanup]"
AGENT_EMAIL_THEME=dark

# Slack webhook (optional)
AGENT_NOTIF_SLACK_ENABLED=false
AGENT_NOTIF_SLACK_WEBHOOK_URL=

# Microsoft Teams webhook (optional)
AGENT_NOTIF_TEAMS_ENABLED=false
AGENT_NOTIF_TEAMS_WEBHOOK_URL=

# HTTP server
AGENT_SERVER_LISTEN=:8080
AGENT_SERVER_ENABLED=true

# SQLite storage path
AGENT_STORAGE_PATH=/data/cleanup.db

# Telemetry
AGENT_TELEMETRY_PUBLIC_IP_URL=https://api.ipify.org

# Recommendation engine
AGENT_RECOMMENDATIONS_WINDOW_DAYS=30
AGENT_RECOMMENDATIONS_TRIGGER_COUNT=18

# Build version (set by CI)
VERSION=1.0.0
